{
  "manifest_version": 3,
  "name": "Personal Agent (Phase 1)",
  "version": "0.1.0",
  "description": "Tool-calling loop: article Q&A + YouTube transcript summarization, routed by the model.",
  "permissions": ["sidePanel", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Personal Agent panel"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
