{
  "manifest_version": 3,
  "name": "Personal Agent (Phase 4)",
  "version": "0.4.0",
  "description": "Adds form-field detection and per-field autofill with explicit confirmation before any write.",
  "permissions": ["sidePanel", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Personal Agent panel"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["gmail.js", "formdetect.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
