{
  "manifest_version": 3,
  "name": "Personal Agent",
  "version": "0.4.0",
  "description": "An AI browser assistant that understands pages, answers questions, and helps fill forms with your approval.",
  "permissions": ["sidePanel", "activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Personal Agent panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "fill-current-form": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Fill the current form using Personal Agent"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["gmail.js", "formdetect.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
